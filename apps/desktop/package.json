{
  "name": "@earthql/desktop",
  "productName": "EarthQL",
  "version": "0.1.2",
  "private": true,
  "description": "EarthQL desktop database client",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:mac:universal": "electron-vite build && electron-builder --mac --universal --publish never"
  },
  "dependencies": {
    "@databricks/sql": "^1.12.0",
    "@earthql/core": "0.1.0",
    "@earthql/driver-databricks": "0.1.0",
    "@earthql/driver-mssql": "0.1.0",
    "@earthql/driver-mysql": "0.1.0",
    "@earthql/driver-postgres": "0.1.0",
    "@napi-rs/keyring": "^1.1.0",
    "archiver": "^7.0.1",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lossless-json": "^4.3.4",
    "mssql": "^12.0.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "pg-cursor": "^2.12.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@tanstack/react-virtual": "^3.11.0",
    "@types/archiver": "^6.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0",
    "zustand": "^5.0.0"
  }
}
