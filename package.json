{
  "name": "earthql",
  "private": true,
  "version": "0.1.0",
  "description": "EarthQL — desktop database client for macOS (PostgreSQL, MySQL, Databricks, SQL Server)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @earthql/desktop",
    "build": "npm run build -w @earthql/desktop",
    "dist:mac": "npm run dist:mac -w @earthql/desktop",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @earthql/desktop",
    "test": "vitest run && node --test feedback/google-apps-script/receiver.test.cjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
